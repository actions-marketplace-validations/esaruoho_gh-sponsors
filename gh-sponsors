#!/usr/bin/env python3
"""
GitHub Sponsors CLI (gh-sponsors)
A standalone CLI script, GitHub CLI extension, and GitHub Action to aggregate and display GitHub Sponsors data.

Usage:
  gh sponsors
  gh sponsors --markdown
  gh sponsors --json
  gh sponsors --csv
  gh sponsors --public-only
  gh sponsors --all-tiers
"""

import sys
import json
import argparse
import subprocess
from datetime import datetime
from typing import Dict, List, Any, Optional

GRAPHQL_QUERY = """
{
  viewer {
    login
    name
    url
    sponsorsListing {
      id
      slug
      url
      dashboardUrl
      shortDescription
      createdAt
      nextPayoutDate
      activeGoal {
        description
        percentComplete
        targetValue
      }
      activeStripeConnectAccount {
        accountId
        countryOrRegion
        isActive
        stripeDashboardUrl
      }
      tiers(first: 50) {
        totalCount
        nodes {
          id
          name
          monthlyPriceInDollars
          monthlyPriceInCents
          isOneTime
          description
          createdAt
        }
      }
    }
    sponsorshipsAsMaintainer(activeOnly: false, includePrivate: true, first: 100) {
      totalCount
      nodes {
        id
        createdAt
        isActive
        isOneTimePayment
        isSponsorOptedIntoEmail
        privacyLevel
        tierSelectedAt
        sponsorEntity {
          ... on User {
            login
            name
            email
            url
            avatarUrl
            bio
            location
            company
            websiteUrl
          }
          ... on Organization {
            login
            name
            email
            url
            avatarUrl
            description
            location
            websiteUrl
          }
        }
        tier {
          id
          name
          monthlyPriceInDollars
          monthlyPriceInCents
          isOneTime
          description
        }
      }
    }
    sponsorsActivities(period: ALL, includePrivate: true, first: 100) {
      totalCount
      nodes {
        action
        timestamp
        currentPrivacyLevel
        paymentSource
        viaBulkSponsorship
        sponsorsTier {
          name
          monthlyPriceInDollars
          monthlyPriceInCents
          isOneTime
        }
        previousSponsorsTier {
          name
          monthlyPriceInDollars
          monthlyPriceInCents
        }
        sponsor {
          ... on User {
            login
            name
            email
            url
            location
            bio
          }
          ... on Organization {
            login
            name
            email
            url
            location
          }
        }
      }
    }
  }
}
"""

# Terminal Colors
class Colors:
    RESET = "\033[0m"
    BOLD = "\033[1m"
    DIM = "\033[2m"
    UNDERLINE = "\033[4m"
    RED = "\033[31m"
    GREEN = "\033[32m"
    YELLOW = "\033[33m"
    BLUE = "\033[34m"
    MAGENTA = "\033[35m"
    CYAN = "\033[36m"
    WHITE = "\033[37m"
    GRAY = "\033[90m"
    B_GREEN = "\033[92m"
    B_YELLOW = "\033[93m"
    B_CYAN = "\033[96m"
    B_WHITE = "\033[97m"

def disable_colors():
    for attr in dir(Colors):
        if not attr.startswith("__"):
            setattr(Colors, attr, "")

def format_date(iso_str: Optional[str]) -> str:
    if not iso_str:
        return "-"
    try:
        dt = datetime.fromisoformat(iso_str.replace("Z", "+00:00"))
        return dt.strftime("%Y-%m-%d %H:%M UTC")
    except Exception:
        return iso_str[:10]

def get_tier_dollars(tier: Optional[Dict[str, Any]]) -> float:
    if not tier:
        return 0.0
    if tier.get("monthlyPriceInDollars") is not None:
        return float(tier["monthlyPriceInDollars"])
    if tier.get("monthlyPriceInCents") is not None:
        return float(tier["monthlyPriceInCents"]) / 100.0
    return 0.0

def fetch_sponsors_data() -> Dict[str, Any]:
    cmd = ["gh", "api", "graphql", "-f", f"query={GRAPHQL_QUERY}"]
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, check=True)
        data = json.loads(res.stdout)
        if "errors" in data:
            msgs = [e.get("message", "") for e in data["errors"]]
            raise RuntimeError("\n".join(msgs))
        return data.get("data", {}).get("viewer", {})
    except FileNotFoundError:
        print(f"{Colors.RED}Error: 'gh' CLI tool not found in PATH.{Colors.RESET}", file=sys.stderr)
        sys.exit(1)
    except subprocess.CalledProcessError as e:
        err_msg = e.stderr or e.stdout
        print(f"{Colors.RED}Error querying GitHub Sponsors API:{Colors.RESET}", file=sys.stderr)
        print(err_msg.strip(), file=sys.stderr)
        if "INSUFFICIENT_SCOPES" in err_msg or "read:user" in err_msg:
            print(f"\n{Colors.YELLOW}Run this command to refresh your token scopes:{Colors.RESET}")
            print(f"  {Colors.BOLD}gh auth refresh -s read:user{Colors.RESET}\n")
        sys.exit(1)

def process_data(viewer: Dict[str, Any], public_only: bool = False) -> Dict[str, Any]:
    listing = viewer.get("sponsorsListing") or {}
    maint_conn = viewer.get("sponsorshipsAsMaintainer") or {}
    act_conn = viewer.get("sponsorsActivities") or {}
    
    entities_by_login: Dict[str, Dict[str, Any]] = {}
    
    for node in maint_conn.get("nodes", []):
        entity = node.get("sponsorEntity") or {}
        login = entity.get("login")
        if not login:
            continue
            
        priv_level = node.get("privacyLevel", "PUBLIC")
        if public_only and priv_level == "PRIVATE":
            continue
            
        entities_by_login[login] = {
            "login": login,
            "name": entity.get("name") or login,
            "email": entity.get("email") or "",
            "url": entity.get("url") or f"https://github.com/{login}",
            "avatarUrl": entity.get("avatarUrl") or "",
            "bio": entity.get("bio") or entity.get("description") or "",
            "location": entity.get("location") or "",
            "company": entity.get("company") or "",
            "websiteUrl": entity.get("websiteUrl") or "",
            "is_active": node.get("isActive", False),
            "privacy_level": priv_level,
            "current_tier": node.get("tier"),
            "relationship_created_at": node.get("createdAt"),
            "tier_selected_at": node.get("tierSelectedAt"),
            "transactions": [],
            "total_dollars": 0.0,
        }
        
    for act in act_conn.get("nodes", []):
        sp = act.get("sponsor") or {}
        login = sp.get("login")
        if not login:
            continue
            
        priv_level = act.get("currentPrivacyLevel", "PUBLIC")
        if public_only and priv_level == "PRIVATE":
            continue
            
        if login not in entities_by_login:
            entities_by_login[login] = {
                "login": login,
                "name": sp.get("name") or login,
                "email": sp.get("email") or "",
                "url": sp.get("url") or f"https://github.com/{login}",
                "avatarUrl": sp.get("avatarUrl") or "",
                "bio": sp.get("bio") or "",
                "location": sp.get("location") or "",
                "company": "",
                "websiteUrl": "",
                "is_active": False,
                "privacy_level": priv_level,
                "current_tier": act.get("sponsorsTier"),
                "relationship_created_at": act.get("timestamp"),
                "tier_selected_at": act.get("timestamp"),
                "transactions": [],
                "total_dollars": 0.0,
            }
            
        tier = act.get("sponsorsTier") or {}
        amount = get_tier_dollars(tier)
        
        tx = {
            "action": act.get("action"),
            "timestamp": act.get("timestamp"),
            "amount_dollars": amount,
            "tier_name": tier.get("name", "Unknown"),
            "is_one_time": tier.get("isOneTime", True),
            "privacy_level": priv_level,
            "payment_source": act.get("paymentSource", "GITHUB"),
        }
        entities_by_login[login]["transactions"].append(tx)
        entities_by_login[login]["total_dollars"] += amount

    for data in entities_by_login.values():
        data["transactions"].sort(key=lambda x: x.get("timestamp") or "")

    active_sponsors = [s for s in entities_by_login.values() if s["is_active"]]
    past_sponsors = [s for s in entities_by_login.values() if not s["is_active"]]
    
    active_sponsors.sort(key=lambda x: x["total_dollars"], reverse=True)
    past_sponsors.sort(key=lambda x: x["total_dollars"], reverse=True)
    
    total_lifetime_dollars = sum(s["total_dollars"] for s in entities_by_login.values())
    total_transactions_count = sum(len(s["transactions"]) for s in entities_by_login.values())
    total_active_monthly_dollars = sum(
        get_tier_dollars(s.get("current_tier")) for s in active_sponsors if not s.get("current_tier", {}).get("isOneTime", False)
    )

    return {
        "viewer_login": viewer.get("login"),
        "viewer_name": viewer.get("name"),
        "listing": listing,
        "active_sponsors": active_sponsors,
        "past_sponsors": past_sponsors,
        "all_sponsors": list(entities_by_login.values()),
        "total_lifetime_dollars": total_lifetime_dollars,
        "total_transactions_count": total_transactions_count,
        "total_active_monthly_dollars": total_active_monthly_dollars,
        "unique_sponsors_count": len(entities_by_login),
    }

def print_markdown(summary: Dict[str, Any]):
    login = summary["viewer_login"]
    print(f"## Sponsors for @{login}")
    print(f"Thank you to everyone who supports this work. Lifetime contributions: **${summary['total_lifetime_dollars']:.2f} USD** from {summary['unique_sponsors_count']} unique supporters.\n")
    
    if summary['active_sponsors']:
        print("### Active Recurring Sponsors")
        for s in summary['active_sponsors']:
            print(f"- **[{s['name']}]({s['url']})** (@{s['login']}) — Total: ${s['total_dollars']:.2f}")
        print()
        
    if summary['past_sponsors']:
        print("### One-Time & Past Sponsors")
        for s in summary['past_sponsors']:
            tx_count = len(s["transactions"])
            count_str = f"({tx_count} contributions)" if tx_count > 1 else ""
            print(f"- **[{s['name']}]({s['url']})** (@{s['login']}) — Total: ${s['total_dollars']:.2f} {count_str}".strip())

def print_rich_report(summary: Dict[str, Any], show_all_tiers: bool = False):
    listing = summary["listing"]
    login = summary["viewer_login"]
    listing_url = listing.get("url") or f"https://github.com/sponsors/{login}"
    goal = listing.get("activeGoal") or {}
    stripe = listing.get("activeStripeConnectAccount") or {}
    
    print()
    print(f"{Colors.BOLD}{Colors.B_CYAN}═══════════════════════════════════════════════════════════════════════════════════════════════{Colors.RESET}")
    print(f"{Colors.BOLD}{Colors.B_WHITE}  🌟 GITHUB SPONSORS — @{login} {Colors.RESET} {Colors.DIM}({listing_url}){Colors.RESET}")
    print(f"{Colors.BOLD}{Colors.B_CYAN}═══════════════════════════════════════════════════════════════════════════════════════════════{Colors.RESET}")
    
    print(f"\n{Colors.BOLD}{Colors.YELLOW}📊 FINANCIAL OVERVIEW{Colors.RESET}")
    print(f"  • {Colors.BOLD}Lifetime Total Received:{Colors.RESET}   {Colors.B_GREEN}${summary['total_lifetime_dollars']:.2f} USD{Colors.RESET} {Colors.DIM}(across {summary['total_transactions_count']} contributions from {summary['unique_sponsors_count']} unique sponsors){Colors.RESET}")
    print(f"  • {Colors.BOLD}Active Recurring Income:{Colors.RESET}    {Colors.B_CYAN}${summary['total_active_monthly_dollars']:.2f}/mo{Colors.RESET} {Colors.DIM}(active monthly sponsors: {len(summary['active_sponsors'])}){Colors.RESET}")
    
    if listing.get("nextPayoutDate"):
        print(f"  • {Colors.BOLD}Next Scheduled Payout:{Colors.RESET}      {Colors.WHITE}{listing['nextPayoutDate']}{Colors.RESET}")
        
    if stripe.get("accountId"):
        status = f"{Colors.GREEN}Active{Colors.RESET}" if stripe.get("isActive") else f"{Colors.RED}Inactive{Colors.RESET}"
        print(f"  • {Colors.BOLD}Stripe Connect Account:{Colors.RESET}     {stripe['accountId']} ({stripe.get('countryOrRegion', 'Finland')}) [{status}]")
        
    if goal.get("targetValue"):
        pct = goal.get("percentComplete", 0)
        target = goal.get("targetValue")
        bar_len = 25
        filled = int((pct / 100.0) * bar_len)
        bar = f"{Colors.GREEN}{'█' * filled}{Colors.GRAY}{'░' * (bar_len - filled)}{Colors.RESET}"
        print(f"  • {Colors.BOLD}Active Funding Goal:{Colors.RESET}        [{bar}] {pct}% (Target: ${target}/mo)")
        if goal.get("description"):
            short_desc = goal["description"][:110] + ("..." if len(goal["description"]) > 110 else "")
            print(f"    {Colors.DIM}\"{short_desc}\"{Colors.RESET}")

    print(f"\n{Colors.BOLD}{Colors.GREEN}🟢 CURRENT ACTIVE SPONSORS ({len(summary['active_sponsors'])}){Colors.RESET}")
    if not summary["active_sponsors"]:
        print(f"  {Colors.DIM}No active recurring sponsors right now.{Colors.RESET}")
    else:
        for s in summary["active_sponsors"]:
            _print_sponsor_card(s, is_active=True)

    print(f"\n{Colors.BOLD}{Colors.MAGENTA}🤝 ALL SPONSORS & HISTORICAL CONTRIBUTIONS ({len(summary['all_sponsors'])}){Colors.RESET}")
    for idx, s in enumerate(summary["all_sponsors"], start=1):
        _print_sponsor_card(s, index=idx)

    tiers = listing.get("tiers", {}).get("nodes", [])
    if tiers:
        print(f"\n{Colors.BOLD}{Colors.CYAN}🏷️ CONFIGURED SPONSORSHIP TIERS ({len(tiers)} Tiers){Colors.RESET}")
        if not show_all_tiers and len(tiers) > 4:
            print(f"  {Colors.DIM}(Showing 4 of {len(tiers)} tiers. Use --all-tiers to inspect all){Colors.RESET}")
            display_tiers = tiers[:4]
        else:
            display_tiers = tiers
            
        for t in display_tiers:
            t_type = f"{Colors.YELLOW}One-time{Colors.RESET}" if t.get("isOneTime") else f"{Colors.GREEN}Monthly{Colors.RESET}"
            dollars = get_tier_dollars(t)
            name = t.get("name", "")
            desc = t.get("description", "").replace("\n", " ")
            if len(desc) > 70:
                desc = desc[:67] + "..."
            print(f"  • {Colors.BOLD}{name:<16}{Colors.RESET} [{t_type:<18}] {Colors.B_WHITE}${dollars:>6.2f}{Colors.RESET}  {Colors.DIM}{desc}{Colors.RESET}")

    print(f"\n{Colors.BOLD}{Colors.B_CYAN}═══════════════════════════════════════════════════════════════════════════════════════════════{Colors.RESET}\n")

def _print_sponsor_card(s: Dict[str, Any], is_active: bool = False, index: Optional[int] = None):
    prefix = f"[{index}] " if index is not None else ""
    name_display = f"{Colors.BOLD}{Colors.B_WHITE}{s['name']}{Colors.RESET} ({Colors.CYAN}@{s['login']}{Colors.RESET})"
    total_badge = f"{Colors.BOLD}{Colors.B_GREEN}${s['total_dollars']:.2f} USD total{Colors.RESET}"
    tx_count = len(s["transactions"])
    count_str = f"{tx_count} contribution" if tx_count == 1 else f"{tx_count} contributions"
    
    status_badge = f"{Colors.GREEN}[ACTIVE RECURRING]{Colors.RESET}" if s["is_active"] else f"{Colors.GRAY}[COMPLETED / PAST]{Colors.RESET}"
    priv_badge = f"{Colors.RED}[PRIVATE]{Colors.RESET}" if s.get("privacy_level") == "PRIVATE" else f"{Colors.GREEN}[PUBLIC]{Colors.RESET}"
    
    print(f"  ┌─ {prefix}{name_display}  {status_badge} {priv_badge} ── {total_badge} ({count_str})")
    
    meta_parts = []
    if s.get("location"):
        meta_parts.append(f"📍 {s['location']}")
    if s.get("company"):
        meta_parts.append(f"🏢 {s['company']}")
    if s.get("email"):
        meta_parts.append(f"✉️ {s['email']}")
    if s.get("websiteUrl"):
        meta_parts.append(f"🌐 {s['websiteUrl']}")
    if meta_parts:
        print(f"  │  {Colors.DIM}{' • '.join(meta_parts)}{Colors.RESET}")
        
    if s.get("bio"):
        print(f"  │  {Colors.DIM}Bio: \"{s['bio']}\"{Colors.RESET}")
        
    print(f"  │  {Colors.BOLD}Transaction History:{Colors.RESET}")
    if not s["transactions"]:
        print(f"  │    {Colors.DIM}No individual transaction records logged.{Colors.RESET}")
    else:
        for t in s["transactions"]:
            date_str = format_date(t.get("timestamp"))
            amt = t.get("amount_dollars", 0.0)
            t_type = "One-time" if t.get("is_one_time") else "Monthly"
            tier_name = t.get("tier_name", "")
            t_priv = f"{Colors.DIM}private{Colors.RESET}" if t.get("privacy_level") == "PRIVATE" else "public"
            print(f"  │    • {Colors.WHITE}{date_str}{Colors.RESET}  →  {Colors.B_GREEN}${amt:>6.2f}{Colors.RESET}  {Colors.YELLOW}[{t_type}]{Colors.RESET}  ({tier_name}) [{t_priv}]")
            
    print(f"  └──────────────────────────────────────────────────────────────────────────────────────────")

def main():
    parser = argparse.ArgumentParser(description="Comprehensive GitHub Sponsors CLI")
    parser.add_argument("--json", action="store_true", help="Output JSON")
    parser.add_argument("--csv", action="store_true", help="Output CSV")
    parser.add_argument("--markdown", action="store_true", help="Output Markdown")
    parser.add_argument("--public-only", action="store_true", help="Filter out private sponsors")
    parser.add_argument("--all-tiers", action="store_true", help="Show all tiers")
    parser.add_argument("--no-color", action="store_true", help="Disable colors")
    args = parser.parse_args()

    if args.no_color or not sys.stdout.isatty():
        disable_colors()

    viewer_data = fetch_sponsors_data()
    summary = process_data(viewer_data, public_only=args.public_only)

    if args.json:
        clean_out = {
            "maintainer": summary["viewer_login"],
            "totals": {
                "lifetime_dollars": summary["total_lifetime_dollars"],
                "active_monthly_recurring_dollars": summary["total_active_monthly_dollars"],
                "transactions_count": summary["total_transactions_count"],
                "unique_sponsors_count": summary["unique_sponsors_count"],
            },
            "payout": {
                "next_payout_date": summary["listing"].get("nextPayoutDate"),
                "stripe_account_id": summary["listing"].get("activeStripeConnectAccount", {}).get("accountId"),
                "country": summary["listing"].get("activeStripeConnectAccount", {}).get("countryOrRegion"),
            },
            "active_sponsors": summary["active_sponsors"],
            "past_sponsors": summary["past_sponsors"],
            "all_sponsors": summary["all_sponsors"],
            "tiers": summary["listing"].get("tiers", {}).get("nodes", []),
        }
        print(json.dumps(clean_out, indent=2))
    elif args.csv:
        import csv
        writer = csv.writer(sys.stdout)
        writer.writerow(["Date", "Login", "Name", "Email", "Amount_USD", "Type", "Privacy", "Status"])
        for s in summary["all_sponsors"]:
            status = "active" if s["is_active"] else "past"
            for t in s["transactions"]:
                writer.writerow([
                    format_date(t.get("timestamp")), s["login"], s["name"], s["email"],
                    f"{t.get('amount_dollars', 0.0):.2f}", "One-time" if t.get("is_one_time") else "Monthly",
                    t.get("privacy_level"), status
                ])
    elif args.markdown:
        print_markdown(summary)
    else:
        print_rich_report(summary, show_all_tiers=args.all_tiers)

if __name__ == "__main__":
    main()
